<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RoTrading</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #0b0f17;
      color: white;
    }

    header {
      background: #111827;
      padding: 18px 7%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid #263044;
    }

    .logo {
      font-size: 27px;
      font-weight: bold;
    }

    .logo span {
      color: #4f8cff;
    }

    nav a {
      color: #cbd5e1;
      text-decoration: none;
      margin-left: 20px;
    }

    .hero {
      text-align: center;
      padding: 80px 20px;
      background: linear-gradient(135deg, #111827, #172554);
    }

    .hero h1 {
      font-size: 48px;
      margin-bottom: 15px;
    }

    .hero h1 span {
      color: #4f8cff;
    }

    .hero p {
      color: #aeb8ca;
      font-size: 18px;
      margin-bottom: 30px;
    }

    .search {
      width: 90%;
      max-width: 600px;
      padding: 16px;
      border-radius: 12px;
      border: 1px solid #334155;
      background: #0f172a;
      color: white;
      font-size: 16px;
    }

    .section {
      padding: 45px 7%;
    }

    .section h2 {
      margin-bottom: 25px;
    }

    .games {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 18px;
    }

    .game {
      background: #151c2b;
      border: 1px solid #263044;
      border-radius: 15px;
      padding: 25px;
      text-align: center;
      transition: 0.2s;
    }

    .game:hover {
      transform: translateY(-4px);
      border-color: #4f8cff;
    }

    .game .emoji {
      font-size: 45px;
      margin-bottom: 12px;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
    }

    .product {
      background: #151c2b;
      border: 1px solid #263044;
      border-radius: 15px;
      padding: 18px;
    }

    .product-image {
      height: 150px;
      border-radius: 12px;
      background: #202a3d;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 60px;
      margin-bottom: 15px;
    }

    .product h3 {
      margin-bottom: 8px;
    }

    .product p {
      color: #94a3b8;
      margin-bottom: 15px;
    }

    .button {
      width: 100%;
      padding: 12px;
      border: 0;
      border-radius: 9px;
      background: #4f8cff;
      color: white;
      font-weight: bold;
      cursor: pointer;
    }

    footer {
      text-align: center;
      padding: 30px;
      background: #080c13;
      color: #64748b;
    }
  </style>
</head>

<body>

  <header>
    <div class="logo">Ro<span>Trading</span></div>

    <nav>
      <a href="#">Inicio</a>
      <a href="#marketplace">Marketplace</a>
      <a href="#juegos">Juegos</a>
    </nav>
  </header>

  <section class="hero">
    <h1>Bienvenido a <span>RoTrading</span></h1>

    <p>
      Tu marketplace para descubrir y organizar tus objetos favoritos.
    </p>

    <input
      class="search"
      type="text"
      placeholder="🔎 Buscar mascotas, objetos o juegos..."
    >
  </section>

  <section class="section" id="juegos">
    <h2>🎮 Explora juegos</h2>

    <div class="games">

      <div class="game">
        <div class="emoji">🐾</div>
        <h3>Adopt Me!</h3>
        <p>Mascotas y objetos</p>
      </div>

      <div class="game">
        <div class="emoji">🧠</div>
        <h3>Brainrot</h3>
        <p>Objetos y coleccionables</p>
      </div>

      <div class="game">
        <div class="emoji">🎮</div>
        <h3>Próximamente</h3>
        <p>Más juegos</p>
      </div>

    </div>
  </section>

  <section class="section" id="marketplace">
    <h2>🔥 Productos destacados</h2>

    <div class="products">

      <div class="product">
        <div class="product-image">🐶</div>
        <h3>Mascota destacada</h3>
        <p>Adopt Me!</p>
        <button class="button">Ver producto</button>
      </div>

      <div class="product">
        <div class="product-image">🧠</div>
        <h3>Brainrot destacado</h3>
        <p>Brainrot</p>
        <button class="button">Ver producto</button>
      </div>

      <div class="product">
        <div class="product-image">⭐</div>
        <h3>Próximamente</h3>
        <p>Nuevo artículo</p>
        <button class="button">Ver producto</button>
      </div>

    </div>
  </section>

  <footer>
    © 2026 RoTrading — Todos los derechos reservados.
  </footer>

</body>
</html>